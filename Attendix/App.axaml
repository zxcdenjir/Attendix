<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Attendix"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Attendix.Controls"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:iri="https://irihi.tech/shared"
             x:Class="Attendix.App"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme Locale="ru-RU" />
        <semi:UrsaSemiTheme Locale="ru-RU" />
        <semi:SemiPopupAnimations />
        <avalonia:MaterialIconStyles />

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="DropDownButton">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Popup FlyoutPresenter:focus-within /template/ Border#LayoutRoot:focus-within">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="NavigationPage:nav-bar-compact:nav-bar-inset">
            <Style Selector="^ /template/ Border#PART_NavigationBar">
                <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
            </Style>
        </Style>

        <Style Selector="u|UrsaWindow /template/ u|TitleBar#PART_TitleBar">
            <Setter Property="Margin" Value="32,0,0,0" />
        </Style>

        <Style Selector="TableView">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TableView /template/ ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="TableView /template/ Border">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="u|StandardDialogControl.PreviewImport">
            <Setter Property="Height" Value="552" />
            <Setter Property="Width" Value="1164" />
            <Setter Property="MinHeight" Value="552" />
            <Setter Property="MinWidth" Value="880" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="u|MessageBoxControl:modal">
            <Setter Property="CornerRadius" Value="10"></Setter>
        </Style>

        <Style Selector="TableViewColumnHeader TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        
        <!--<Style Selector="u|StandardDialogControl:modal /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource DialogBlurBg}" />
        </Style>

        <Style Selector="u|MessageBoxControl:modal /template/ Border">
            <Setter Property="Background" Value="{DynamicResource DialogBlurBg}" />
        </Style>-->
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DialogBlurBg" Color="#57FFFFFF"></SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DialogBlurBg" Color="#5735363c"></SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Attendix"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:Attendix.Controls"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:iri="https://irihi.tech/shared"
             x:Class="Attendix.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <semi:SemiTheme Locale="ru-RU" />
        <semi:UrsaSemiTheme Locale="ru-RU" />
        <semi:SemiPopupAnimations />
        <avalonia:MaterialIconStyles />

        <Style Selector="TextBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="u|TimeOnlyPicker">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="DropDownButton">
            <Setter Property="Padding" Value="10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="Popup">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="Popup FlyoutPresenter:focus-within /template/ Border#LayoutRoot:focus-within">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="NavigationPage:nav-bar-compact:nav-bar-inset">
            <Style Selector="^ /template/ Border#PART_NavigationBar">
                <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightActive}" />
            </Style>
        </Style>

        <Style Selector="u|UrsaWindow /template/ u|TitleBar#PART_TitleBar">
            <Setter Property="Margin" Value="32,0,0,0" />
        </Style>

        <Style Selector="TableView">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="TableView /template/ ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>

        <Style Selector="TableView /template/ Border">
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="u|StandardDialogControl.PreviewImport">
            <Setter Property="Height" Value="552" />
            <Setter Property="Width" Value="1164" />
            <Setter Property="MinHeight" Value="552" />
            <Setter Property="MinWidth" Value="880" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        
        <Style Selector="u|StandardDialogControl.Groups">
            <Setter Property="Height" Value="705" />
            <Setter Property="Width" Value="641" />
            <Setter Property="MinHeight" Value="420" />
            <Setter Property="MinWidth" Value="641" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style Selector="u|MessageBoxControl:modal">
            <Setter Property="CornerRadius" Value="10"></Setter>
        </Style>

        <Style Selector="TableViewColumnHeader TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TableViewRow:selected /template/ Border#PART_ContentBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TableViewRow:pointerover /template/ Border#PART_ContentBorder">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        
        <Style Selector="TableView">
            <Setter Property="ItemContainerTheme">
                <Setter.Value>
                    <ControlTheme TargetType="TableViewRow" BasedOn="{StaticResource {x:Type TableViewRow}}">
                        <Setter Property="Focusable" Value="False" />
                        <Style Selector="^:selected /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:selected:pointerover /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:selected:pressed /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:pointerover /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:pressed /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                    </ControlTheme>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Styles>


    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AttendixLateBrush" Color="#80FFEB3B" />
                    <SolidColorBrush x:Key="AttendixEarlyBrush" Color="#80FFEB3B" />
                    <SolidColorBrush x:Key="AttendixAbsentBrush" Color="#52EF4444" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AttendixLateBrush" Color="#80FFEB3B" />
                    <SolidColorBrush x:Key="AttendixEarlyBrush" Color="#80FFEB3B" />
                    <SolidColorBrush x:Key="AttendixAbsentBrush" Color="#52EF4444" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Attendix.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:services="clr-namespace:Attendix.Services"
             xmlns:models="clr-namespace:Attendix.Models"
             xmlns:controls="clr-namespace:Attendix.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Attendix.Views.HomeView"
             x:DataType="viewModels:HomeViewModel"
             Header="Attendix">
    <ContentPage.Resources>
        <ControlTheme x:Key="ArrivalCellTheme"
                      TargetType="TableViewCell"
                      BasedOn="{StaticResource {x:Type TableViewCell}}"
                      x:DataType="models:Student">
            <Style Selector="^">
                <Setter Property="controls:DataClasses.Late" Value="{Binding LateHighlight}" />
                <Setter Property="controls:DataClasses.Absent" Value="{Binding AbsentHighlight}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="DepartureCellTheme"
                      TargetType="TableViewCell"
                      BasedOn="{StaticResource {x:Type TableViewCell}}"
                      x:DataType="models:Student">
            <Style Selector="^">
                <Setter Property="controls:DataClasses.Early" Value="{Binding EarlyHighlight}" />
                <Setter Property="controls:DataClasses.Absent" Value="{Binding AbsentHighlight}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="AttendanceCellTheme"
                      TargetType="TableViewCell"
                      BasedOn="{StaticResource {x:Type TableViewCell}}"
                      x:DataType="models:Student">
            <Style Selector="^">
                <Setter Property="controls:DataClasses.Absent" Value="{Binding IsAbsent}" />
            </Style>
        </ControlTheme>
    </ContentPage.Resources>
    <ContentPage.Styles>
        <Style Selector="u|FormItem">
            <Setter Property="Margin" Value="0" />
        </Style>

        <!-- заливка ячеек; DynamicResource сам обновится при смене темы -->
        <Style Selector="TableViewCell.absent">
            <Setter Property="Background" Value="{DynamicResource AttendixAbsentBrush}" />
        </Style>
        <Style Selector="TableViewCell.late">
            <Setter Property="Background" Value="{DynamicResource AttendixLateBrush}" />
        </Style>
        <Style Selector="TableViewCell.early">
            <Setter Property="Background" Value="{DynamicResource AttendixEarlyBrush}" />
        </Style>
    </ContentPage.Styles>
    <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10" Margin="20">
        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" ColumnSpacing="10"
              IsEnabled="{Binding IsPanelEnabled}">
            <TextBox PlaceholderText="Поиск" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Classes="clearButton" />
            <DropDownButton Grid.Column="1" VerticalAlignment="Stretch" ToolTip.Tip="Фильтры" BorderThickness="0">
                <avalonia:MaterialIcon Kind="Filter" VerticalAlignment="Stretch" />
                <DropDownButton.Flyout>
                    <Flyout>
                        <u:Form Margin="5">
                            <u:Form.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </u:Form.ItemsPanel>
                            <TextBlock Text="Фильтры" FontWeight="Bold" />
                            <CheckBox Content="Прогулы" IsChecked="{Binding ShowAbsent, Mode=TwoWay}" />
                            <CheckBox Content="Опоздавшие" IsChecked="{Binding ShowLate, Mode=TwoWay}" />
                            <CheckBox Content="Ушедшие рано" IsChecked="{Binding ShowLeft, Mode=TwoWay}" />
                            <ComboBox u:FormItem.Label="Группа" Classes="clearButton"
                                      ItemsSource="{Binding Groups}"
                                      SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" />
                            <Button Classes="Danger" Content="Очистить фильтры" HorizontalAlignment="Stretch"
                                    Command="{Binding ResetFiltersCommand}" />
                        </u:Form>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="2" VerticalAlignment="Stretch" ToolTip.Tip="Экспорт в таблицу" BorderThickness="0"
                    Width="{Binding $self.Bounds.Height}" Theme="{StaticResource SolidButton}"
                    Command="{Binding ExportToXlsxCommand}">
                <avalonia:MaterialIcon Kind="Export" VerticalAlignment="Stretch" />
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Stretch" ToolTip.Tip="Импорт из таблицы" BorderThickness="0"
                    Width="{Binding $self.Bounds.Height}"
                    Command="{Binding ImportDataCommand}">
                <avalonia:MaterialIcon Kind="Import" VerticalAlignment="Stretch" />
            </Button>
            <Button Grid.Column="4" VerticalAlignment="Stretch" ToolTip.Tip="Очистить данные"
                    Width="{Binding $self.Bounds.Height}"
                    Command="{Binding ClearDataCommand}"
                    Theme="{StaticResource OutlineButton}"
                    Classes="Danger">
                <avalonia:MaterialIcon Kind="ClearCircle" VerticalAlignment="Stretch" />
            </Button>
            <DropDownButton Grid.Column="5" VerticalAlignment="Stretch" ToolTip.Tip="Настройки" BorderThickness="0">
                <avalonia:MaterialIcon Kind="Settings" VerticalAlignment="Stretch" />
                <DropDownButton.Flyout>
                    <Flyout>
                        <u:Form x:DataType="services:Settings"
                                Margin="5"
                                DataContext="{x:Static services:Settings.Current}"
                                HorizontalAlignment="Stretch" MinWidth="150">
                            <u:Form.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </u:Form.ItemsPanel>
                            <TextBlock Text="Настройки" FontWeight="Bold" Focusable="True" />
                            <u:TimeOnlyPicker u:FormItem.Label="Начало уроков" NeedConfirmation="True"
                                              DisplayFormat="HH:mm" PanelFormat="HH mm"
                                              CornerRadius="10" Padding="10"
                                              SelectedTime="{Binding StartOfClasses, Mode=TwoWay}" />
                            <u:TimeOnlyPicker u:FormItem.Label="Конец уроков" NeedConfirmation="True"
                                              DisplayFormat="HH:mm" PanelFormat="HH mm"
                                              CornerRadius="10" Padding="10"
                                              SelectedTime="{Binding EndOfClasses, Mode=TwoWay}" />
                            <CheckBox Content="Подсвечивать клетки"
                                      IsChecked="{Binding HighlightCells, Mode=TwoWay}" />
                        </u:Form>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <Panel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                    IsVisible="{Binding DataIsEmpty}">
                <StackPanel Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Text="Данных ещё нет"
                               TextAlignment="Center"
                               FontSize="30"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <Button Content="Импортировать данные из таблицы" Command="{Binding ImportDataCommand}" />
                </StackPanel>
            </Border>

            <TableView ItemsSource="{Binding FilteredStudents}" IsVisible="{Binding !DataIsEmpty}"
                       SelectingItemsControl.IsTextSearchEnabled="True">
                <TableView.ItemContainerTheme>
                    <ControlTheme TargetType="TableViewRow" BasedOn="{StaticResource {x:Type TableViewRow}}">
                        <Setter Property="Focusable" Value="False" />
                        <Style Selector="^:selected /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:selected:pointerover /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:selected:pressed /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:pointerover /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                        <Style Selector="^:pressed /template/ Border#BackgroundBorder">
                            <Setter Property="Background" Value="{DynamicResource TableViewRowBackground}" />
                        </Style>
                    </ControlTheme>
                </TableView.ItemContainerTheme>
                <TableView.Columns>
                    <TableViewColumn Header="Дата" Binding="{Binding Date}" Width="114*">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Date}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>
                    <TableViewColumn Header="Класс" Width="96*">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Group}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>
                    <TableViewColumn Header="ФИО" Width="290*">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" TextWrapping="WrapWithOverflow"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>
                    <TableViewColumn Header="Первый приход" Width="155*" CellTheme="{StaticResource ArrivalCellTheme}">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Student">
                                <TextBlock Text="{Binding FirstArrivalDisplay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>

                    <TableViewColumn Header="Последний уход" Width="155*" CellTheme="{StaticResource DepartureCellTheme}">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Student">
                                <TextBlock Text="{Binding LastDepartureDisplay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>

                    <TableViewColumn Header="Посещаемость" Width="280*">
                        <TableViewColumn.CellTemplate>
                            <DataTemplate x:DataType="models:Student">
                                <TextBlock Text="{Binding Attendance}" TextTrimming="CharacterEllipsis"
                                           TextWrapping="WrapWithOverflow" />
                            </DataTemplate>
                        </TableViewColumn.CellTemplate>
                    </TableViewColumn>
                </TableView.Columns>
            </TableView>
        </Panel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0 -6 0 0" BorderThickness="2" VerticalAlignment="Top"
                     IsVisible="{Binding IsLoading}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" IsVisible="{Binding !DataIsEmpty}">
            <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Показано: {0} | Всего: {1}">
                        <Binding Path="FilteredStudents.Count" />
                        <Binding Path="Students.Count" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Margin="0,0,0,0"
                       IsVisible="{Binding SelectedGroup, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Text>
                    <MultiBinding StringFormat=" | В группе «{0}»: {1}">
                        <Binding Path="SelectedGroup" />
                        <Binding Path="TotalInSelectedGroup" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </StackPanel>
    </Grid>
</ContentPage>
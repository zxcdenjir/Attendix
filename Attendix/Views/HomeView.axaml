<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Attendix.ViewModels"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
             x:Class="Attendix.Views.HomeView"
             x:DataType="viewModels:HomeViewModel"
             Header="Attendix">

    <Grid RowDefinitions="Auto, *" RowSpacing="10" Margin="20">
        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto" ColumnSpacing="10" IsEnabled="{Binding IsPanelEnabled}">
            <TextBox PlaceholderText="Поиск" Name="SearchBox" />
            <DropDownButton Grid.Column="1" VerticalAlignment="Stretch" ToolTip.Tip="Фильтры" BorderThickness="0">
                <avalonia:MaterialIcon Kind="Filter" VerticalAlignment="Stretch" />
            </DropDownButton>
            <Button Grid.Column="2" VerticalAlignment="Stretch" ToolTip.Tip="Экспорт в XLSX" BorderThickness="0"
                    Width="{Binding $self.Bounds.Height}" Theme="{StaticResource SolidButton}">
                <avalonia:MaterialIcon Kind="Export" VerticalAlignment="Stretch" />
            </Button>
            <Button Grid.Column="3" VerticalAlignment="Stretch" ToolTip.Tip="Импорт из XLSX" BorderThickness="0"
                    Width="{Binding $self.Bounds.Height}"
                    Command="{Binding ImportDataCommand}">
                <avalonia:MaterialIcon Kind="Import" VerticalAlignment="Stretch" />
            </Button>
            <Button Grid.Column="4" VerticalAlignment="Stretch" ToolTip.Tip="Очистить данные"
                    Width="{Binding $self.Bounds.Height}"
                    Command="{Binding ClearDataCommand}"
                    Theme="{StaticResource OutlineButton}"
                    Classes="Danger">
                <avalonia:MaterialIcon Kind="ClearCircle" VerticalAlignment="Stretch" />
            </Button>
        </Grid>
        
        <Panel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}" 
                    IsVisible="{Binding DataIsEmpty}">
                <StackPanel Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontWeight="Bold"
                               Text="Данных ещё нет"
                               TextAlignment="Center"
                               FontSize="30"
                               Foreground="{DynamicResource SemiColorText2}"/>
                    <Button Content="Импортировать данные из xlsx" Command="{Binding ImportDataCommand}"/>
                </StackPanel>
            </Border>
            
            <TableView ItemsSource="{Binding FilteredStudents}" IsVisible="{Binding !DataIsEmpty}">
                <TableView.Columns>
                    <TableViewColumn Header="ФИО" Binding="{Binding FullName}"></TableViewColumn>
                    <TableViewColumn Header="Дата" Binding="{Binding Date}"></TableViewColumn>
                </TableView.Columns>
            </TableView>
        </Panel>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Margin="0 -6 0 0" BorderThickness="2" VerticalAlignment="Top"
                     IsVisible="{Binding IsLoading}"/>
    </Grid>
</ContentPage>
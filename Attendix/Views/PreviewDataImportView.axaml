<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Attendix.ViewModels"
             xmlns:u="https://irihi.tech/ursa"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Attendix.Views.PreviewDataImportView"
             x:DataType="vm:PreviewDataImportViewModel">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10"
          MinWidth="620" MinHeight="380">

        <StackPanel Spacing="10">
            <CheckBox Content="Первая строка - заголовки "
                      IsChecked="{Binding HasHeader, Mode=TwoWay}" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="5">
                    <TextBlock Text="Id:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Columns}"
                              SelectedItem="{Binding SelectedIdColumn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="ФИО:" VerticalAlignment="Center" />
                    <ComboBox
                        ItemsSource="{Binding Columns}"
                        SelectedItem="{Binding SelectedFullNameColumn, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Text="Дата/время:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Columns}"
                              SelectedItem="{Binding SelectedDateTimeColumn, Mode=TwoWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <TableView ItemsSource="{Binding PreviewStudents}" Grid.Row="2" >
            <TableView.Columns>
                <TableViewColumn Header="Id" Binding="{Binding Id}" />
                <TableViewColumn Header="ФИО" Binding="{Binding FullName}" />
                <TableViewColumn Header="Дата/время" Binding="{Binding Date}" />
            </TableView.Columns>
        </TableView>
    </Grid>
</UserControl>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--Имя сборки/exe — Attendix (имя проекта Attendix.Desktop не менялось; parcel привязан к $(AssemblyName));
    библиотека тогда обязана называться Attendix.Core, иначе две Attendix.dll в одной папке-->
    <AssemblyName>Attendix</AssemblyName>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationIcon>avalonia-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Attendix\Attendix.csproj" />
  </ItemGroup>
</Project>

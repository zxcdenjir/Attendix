{
    "GeneralSettings": {
        "NetProjectPath": "Attendix.Desktop.csproj",
        "PackageName": "Attendix",
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "ApplicationName": "Attendix",
        "Version": "1.0.0",
        "Icon": "avalonia-logo.ico",
        "Company": "KSIPT"
    },
    "LinuxSettings": {
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "InstallerIcon": "avalonia-logo.ico",
        "InstallerRequiresAdmin": "False",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.CompanyName.Attendix",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "ExtraBuildProperties": {}
    }
}